{
  "name": "acadcheck-backend",
  "version": "1.0.0",
  "description": "Backend API for AcadCheck application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "preflight": "node deployment-preflight.js",
    "test:insights": "node --test test-question-insights-engine.js",
    "test:scanner": "node test-camera-access.js && node test-sequence-detector.js && node test-multimark.js && node test-answer-sheet-generator.js && node test-fast-omr-contract.js && python ../ml-training/benchmark_fast_omr.py --quick --summary",
    "test:scanner:quality": "python ../ml-training/benchmark_fast_omr.py --summary"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "adm-zip": "^0.6.0",
    "bcrypt": "6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "onnxruntime-node": "^1.27.0",
    "sharp": "0.35.4",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
