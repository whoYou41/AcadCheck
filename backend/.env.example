# AcadCheck backend
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=acadcheck_db
DB_USER=root
DB_PASSWORD=

# Replace with a long, random value before starting the backend.
JWT_SECRET=replace-with-a-long-random-secret

# Windows commonly uses "python"; Linux commonly uses "python3".
OMR_PYTHON=python
QR_PYTHON=python

# Optional Raspberry Pi camera service, for example http://192.168.1.20:5000
PI_CAMERA_URL=

# Optional scanner tuning
OMR_FAST_TIMEOUT_MS=8000
QR_DETECTION_TIMEOUT_MS=5000
ONNX_BUBBLE_RAW_THRESHOLD=0.50

# Optional Windows printer name. Blank uses the default printer.
ACADCHECK_PRINTER_NAME=
