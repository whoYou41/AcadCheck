# AcadCheck backend
PORT=3000
NODE_ENV=production

# Comma-separated browser/app origins that may call the API directly.
# Leave blank for same-origin web deployment. Example:
# CORS_ORIGINS=https://acadcheck.example.edu,capacitor://localhost
CORS_ORIGINS=
TRUST_PROXY=false
PUBLIC_REGISTRATION=false
# Required only while creating the first administrator. Generate at least 24
# random characters, use it once through X-Bootstrap-Token, then remove it.
BOOTSTRAP_ADMIN_TOKEN=
API_JSON_LIMIT_MB=12
SCAN_UPLOAD_LIMIT_MB=15
API_RATE_LIMIT=1200

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=acadcheck_db
DB_USER=root
DB_PASSWORD=

# Replace with a long, random value before starting the backend.
JWT_SECRET=replace-with-a-long-random-secret

# Prefer the dedicated project scanner environment. AcadCheck discovers this
# path automatically when it exists; explicit values are useful for services.
# Windows: C:\AcadCheck\.scanner-venv\Scripts\python.exe
# Linux: /opt/acadcheck/.scanner-venv/bin/python
OMR_PYTHON=
QR_PYTHON=

# Optional Raspberry Pi camera service, for example http://192.168.1.20:5000
PI_CAMERA_URL=

# Optional scanner tuning
OMR_FAST_TIMEOUT_MS=8000
QR_DETECTION_TIMEOUT_MS=12000
QR_WARMUP_TIMEOUT_MS=15000
ONNX_BUBBLE_RAW_THRESHOLD=0.50
SCANNER_PIPELINE_VERSION=acadcheck-omr-2026.08
LIVE_DETECTION_TTL_MS=15000
LIVE_DETECTION_CACHE_LIMIT=24
DB_TRANSACTION_POOL_SIZE=4

# Optional Windows printer name. Blank uses the default printer.
ACADCHECK_PRINTER_NAME=
